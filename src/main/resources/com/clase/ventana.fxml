<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.clase.VentanaController">
   <children>
      <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <MenuBar>
               <menus>
                  <Menu mnemonicParsing="false" text="Archivo">
                     <items>
                        <MenuItem mnemonicParsing="false" fx:id="abrirVentana" onAction="#abrirDir" text="Abrir carpeta" />
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem mnemonicParsing="false" fx:id="menuSalir" onAction="#salirApp" text="Salir">
                           <accelerator>
                              <KeyCodeCombination alt="UP" code="S" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                           </accelerator>
                        </MenuItem>
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="Informes">
                     <items>
                        <MenuItem mnemonicParsing="false" fx:id="informePacientes" onAction="#informePacientes" text="Informe Pacientes" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="Ayuda">
                     <items>
                        <MenuItem mnemonicParsing="false" fx:id="acercade" onAction="#mostrarAcercade" text="Acerca de" />
                     </items>
                  </Menu>
               </menus>
            </MenuBar>
            <ToolBar>
               <items>
                  <Button fx:id="btnAbrirdir" mnemonicParsing="false" onAction="#abrirDir">
                     <graphic>
                        <SVGPath content="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" fill="#333333" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="Abrir carpeta" />
                     </tooltip>
                  </Button>
                  <Separator orientation="VERTICAL" />
                  <Button fx:id="btnToolsalir" mnemonicParsing="false" onAction="#salirApp">
                     <graphic>
                        <SVGPath content="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" fill="#333333" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="Salir (Ctrl+S)" />
                     </tooltip>
                  </Button>
               </items>
            </ToolBar>
            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
               <tabs>
                  <Tab text="Pacientes">
                     <content>
                        <fx:include fx:id="panelPacientes" source="pacientes.fxml" />
                     </content>
                  </Tab>
                  <Tab text="Doctores">
                     <content>
                        <fx:include fx:id="panelDoctores" source="doctores.fxml" />
                     </content>
                  </Tab>
                  <Tab text="Citas">
                     <content>
                        <fx:include fx:id="panelCitas" source="citas.fxml" />
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
