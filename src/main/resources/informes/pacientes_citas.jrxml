<?xml version="1.0" encoding="UTF-8"?>
<!-- INFORME PRINCIPAL con SUBINFORME: cada paciente y debajo sus citas.
     El subinforme compilado llega desde Java en el parámetro SUBINFORME -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="pacientes_citas" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7f3a9b4c-0d2e-4c8f-9e3a-3c4d5e6f7a88">
	<parameter name="SUBINFORME" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT dnipac, apelpac, nompac FROM pacientes ORDER BY apelpac, nompac]]>
	</queryString>
	<field name="dnipac" class="java.lang.String"/>
	<field name="apelpac" class="java.lang.String"/>
	<field name="nompac" class="java.lang.String"/>
	<title>
		<band height="36">
			<staticText>
				<reportElement x="0" y="0" width="555" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="16" isBold="true"/>
				</textElement>
				<text><![CDATA[PACIENTES Y SUS CITAS]]></text>
			</staticText>
		</band>
	</title>
	<detail>
		<band height="44">
			<textField>
				<reportElement mode="Opaque" x="0" y="2" width="555" height="20" backcolor="#E3F2EA"/>
				<textElement verticalAlignment="Middle"><font isBold="true"/><paragraph leftIndent="5"/></textElement>
				<textFieldExpression><![CDATA[$F{apelpac} + ", " + $F{nompac} + "  (" + $F{dnipac} + ")"]]></textFieldExpression>
			</textField>
			<subreport>
				<reportElement positionType="Float" x="0" y="24" width="555" height="18"/>
				<subreportParameter name="DNI">
					<subreportParameterExpression><![CDATA[$F{dnipac}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression><![CDATA[$P{SUBINFORME}]]></subreportExpression>
			</subreport>
		</band>
	</detail>
	<pageFooter>
		<band height="20">
			<textField>
				<reportElement x="0" y="2" width="555" height="18"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
