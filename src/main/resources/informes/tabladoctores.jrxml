<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe SIN consulta SQL: los datos llegan desde Java como una lista de objetos Doctor.
     Cada field se llama como la propiedad del getter: getApellidos() -> apellidos -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="tabladoctores" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3e1c7d2a-8b4f-4f6a-9c0d-1a2b3c4d5e66">
	<parameter name="TITULO" class="java.lang.String"/>
	<field name="apellidos" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="movil" class="java.lang.String"/>
	<field name="especialidad" class="java.lang.String"/>
	<title>
		<band height="36">
			<textField>
				<reportElement x="0" y="0" width="555" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="16" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{TITULO}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="22">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="220" height="20" backcolor="#DDDDDD"/>
				<textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Apellidos, Nombre]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="220" y="0" width="120" height="20" backcolor="#DDDDDD"/>
				<textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Móvil]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="340" y="0" width="215" height="20" backcolor="#DDDDDD"/>
				<textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Especialidad]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="20">
			<textField>
				<reportElement x="0" y="0" width="220" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{apellidos} + ", " + $F{nombre}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="220" y="0" width="120" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{movil}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="340" y="0" width="215" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{especialidad}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<summary>
		<band height="26">
			<textField>
				<reportElement x="0" y="4" width="555" height="20"/>
				<textElement textAlignment="Right"><font isBold="true"/></textElement>
				<textFieldExpression><![CDATA["Total: " + $V{REPORT_COUNT}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
