<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cita" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail" uuid="6c2b8a43-5d0e-4c1b-9f43-2a7e1f3b9d22">
	<!-- Se le pasa el id de la cita seleccionada en la tabla -->
	<parameter name="IDCITA" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT c.idcita, c.fechacita, c.horacita, c.motivo, c.diagnostico, c.tratamiento, c.estadocita,
       p.dnipac, p.apelpac, p.nompac, p.movilpac,
       d.apeldoc, d.nomdoc, d.espedoc
FROM citas c
INNER JOIN pacientes p ON c.citadnipac = p.dnipac
INNER JOIN doctores d ON c.citaiddoc = d.iddoc
WHERE c.idcita = $P{IDCITA}]]>
	</queryString>
	<field name="idcita" class="java.lang.Integer"/>
	<field name="fechacita" class="java.sql.Date"/>
	<field name="horacita" class="java.lang.String"/>
	<field name="motivo" class="java.lang.String"/>
	<field name="diagnostico" class="java.lang.String"/>
	<field name="tratamiento" class="java.lang.String"/>
	<field name="estadocita" class="java.lang.String"/>
	<field name="dnipac" class="java.lang.String"/>
	<field name="apelpac" class="java.lang.String"/>
	<field name="nompac" class="java.lang.String"/>
	<field name="movilpac" class="java.lang.String"/>
	<field name="apeldoc" class="java.lang.String"/>
	<field name="nomdoc" class="java.lang.String"/>
	<field name="espedoc" class="java.lang.String"/>
	<title>
		<band height="50">
			<staticText>
				<reportElement x="0" y="0" width="555" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="18" isBold="true"/>
				</textElement>
				<text><![CDATA[JUSTIFICANTE DE CITA]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="40" width="555" height="1"/>
			</line>
		</band>
	</title>
	<detail>
		<band height="260">
			<staticText>
				<reportElement x="0" y="0" width="120" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<text><![CDATA[Nº cita:]]></text>
			</staticText>
			<textField>
				<reportElement x="120" y="0" width="150" height="20"/>
				<textFieldExpression><![CDATA[$F{idcita}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="300" y="0" width="80" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<text><![CDATA[Estado:]]></text>
			</staticText>
			<textField>
				<reportElement x="380" y="0" width="175" height="20"/>
				<textFieldExpression><![CDATA[$F{estadocita}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="0" y="24" width="120" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<text><![CDATA[Fecha y hora:]]></text>
			</staticText>
			<textField>
				<reportElement x="120" y="24" width="435" height="20"/>
				<textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fechacita}) + "  a las  " + $F{horacita}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="0" y="48" width="120" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<text><![CDATA[Paciente:]]></text>
			</staticText>
			<textField>
				<reportElement x="120" y="48" width="435" height="20"/>
				<textFieldExpression><![CDATA[$F{apelpac} + ", " + $F{nompac} + "  (DNI " + $F{dnipac} + ")"]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="0" y="72" width="120" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<text><![CDATA[Doctor:]]></text>
			</staticText>
			<textField>
				<reportElement x="120" y="72" width="435" height="20"/>
				<textFieldExpression><![CDATA[$F{apeldoc} + ", " + $F{nomdoc} + " — " + $F{espedoc}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="0" y="96" width="120" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<text><![CDATA[Motivo:]]></text>
			</staticText>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="120" y="96" width="435" height="20"/>
				<textFieldExpression><![CDATA[$F{motivo}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement positionType="Float" x="0" y="124" width="555" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<text><![CDATA[Diagnóstico:]]></text>
			</staticText>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="144" width="555" height="40"/>
				<box><pen lineWidth="0.5"/></box>
				<textFieldExpression><![CDATA[$F{diagnostico}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement positionType="Float" x="0" y="192" width="555" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<text><![CDATA[Tratamiento:]]></text>
			</staticText>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="212" width="555" height="40"/>
				<box><pen lineWidth="0.5"/></box>
				<textFieldExpression><![CDATA[$F{tratamiento}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="24">
			<textField>
				<reportElement x="0" y="4" width="555" height="18"/>
				<textElement textAlignment="Right"><font isItalic="true"/></textElement>
				<textFieldExpression><![CDATA["Impreso el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
