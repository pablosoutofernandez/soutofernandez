<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.clase.VentanaController">
   <children>
      <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <menus>
            <Menu mnemonicParsing="false" text="Archivo">
               <items>
                  <MenuItem mnemonicParsing="false" fx:id="abrirVentana" onAction="#abrirDir" text="Abrir carpeta" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" fx:id="menuSalir" onAction="#salirApp" text="Salir" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Informes">
               <items>
                  <MenuItem mnemonicParsing="false" fx:id="informePacientes" onAction="#informePacientes" text="Informe Pacientes" />
                  <MenuItem mnemonicParsing="false" fx:id="informeDoctores" onAction="#informeDoctores" text="Informe Doctores" />
                  <MenuItem mnemonicParsing="false" fx:id="informeTablaDoctores" onAction="#informeTablaDoctores" text="Doctores en pantalla" />
                  <MenuItem mnemonicParsing="false" fx:id="informePacientesCitas" onAction="#informePacientesCitas" text="Pacientes y sus citas" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" fx:id="imprimirCita" onAction="#imprimirCita" text="Imprimir Cita" />
                  <MenuItem mnemonicParsing="false" fx:id="informeCitasPaciente" onAction="#informeCitasPaciente" text="Citas del paciente" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Ayuda">
               <items>
                  <MenuItem mnemonicParsing="false" fx:id="acercade" onAction="#mostrarAcercade" text="Acerca de" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
      <TabPane tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="25.0">
         <tabs>
            <Tab text="Pacientes">
               <content>
                  <fx:include fx:id="panelPacientes" source="pacientes.fxml" />
               </content>
            </Tab>
            <Tab text="Doctores">
               <content>
                  <fx:include fx:id="panelDoctores" source="doctores.fxml" />
               </content>
            </Tab>
            <Tab text="Citas">
               <content>
                  <fx:include fx:id="panelCitas" source="citas.fxml" />
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </children>
</AnchorPane>
