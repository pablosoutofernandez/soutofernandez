<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="citaspaciente" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail" uuid="9a3d4e55-7f61-4c2d-8b19-3c4d5e6f7a33">
	<parameter name="DNI" class="java.lang.String"/>
	<parameter name="PACIENTE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT c.idcita, c.fechacita, c.horacita, c.motivo, c.estadocita, d.apeldoc, d.espedoc
FROM citas c
INNER JOIN doctores d ON c.citaiddoc = d.iddoc
WHERE c.citadnipac = $P{DNI}
ORDER BY c.fechacita, c.horacita]]>
	</queryString>
	<field name="idcita" class="java.lang.Integer"/>
	<field name="fechacita" class="java.sql.Date"/>
	<field name="horacita" class="java.lang.String"/>
	<field name="motivo" class="java.lang.String"/>
	<field name="estadocita" class="java.lang.String"/>
	<field name="apeldoc" class="java.lang.String"/>
	<field name="espedoc" class="java.lang.String"/>
	<!-- Variable: cuenta solo las citas pendientes -->
	<variable name="pendientes" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["Pendiente".equals($F{estadocita}) ? 1 : 0]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<title>
		<band height="56">
			<staticText>
				<reportElement x="0" y="0" width="555" height="28"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="16" isBold="true"/>
				</textElement>
				<text><![CDATA[HISTORIAL DE CITAS]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="30" width="555" height="20"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$P{PACIENTE} + "  —  DNI " + $P{DNI}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="22">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="40" height="20" backcolor="#DDDDDD"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Nº]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="40" y="0" width="75" height="20" backcolor="#DDDDDD"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Fecha]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="115" y="0" width="45" height="20" backcolor="#DDDDDD"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Hora]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="160" y="0" width="150" height="20" backcolor="#DDDDDD"/>
				<textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Doctor]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="310" y="0" width="175" height="20" backcolor="#DDDDDD"/>
				<textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Motivo]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="485" y="0" width="70" height="20" backcolor="#DDDDDD"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Estado]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="20">
			<textField>
				<reportElement x="0" y="0" width="40" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{idcita}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy">
				<reportElement x="40" y="0" width="75" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{fechacita}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="115" y="0" width="45" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{horacita}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="160" y="0" width="150" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{apeldoc} + " (" + $F{espedoc} + ")"]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="310" y="0" width="175" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{motivo}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="485" y="0" width="70" height="20">
					<!-- color rojo si está anulada -->
					<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA["Anulada".equals($F{estadocita}) ? "#CC0000" : "#000000"]]></propertyExpression>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{estadocita}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<summary>
		<band height="30">
			<textField>
				<reportElement x="0" y="8" width="555" height="20"/>
				<textElement textAlignment="Right"><font isBold="true"/></textElement>
				<textFieldExpression><![CDATA["Total citas: " + $V{REPORT_COUNT} + "   ·   Pendientes: " + $V{pendientes}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
